{
  "name": "gitagotchi",
  "displayName": "Gitagotchi",
  "description": "A VSCode pet that grows from Git diffs, commits, and debugging progress.",
  "version": "0.1.0",
  "publisher": "gitagotchi",
  "license": "MIT",
  "icon": "resources/gitagotchi-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hobby2025/Gitagotchi.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
    "activationEvents": [
      "onStartupFinished",
      "onCommand:gitagotchi.openPet",
      "onCommand:gitagotchi.renamePet",
      "onCommand:gitagotchi.resetPet",
      "onCommand:gitagotchi.feed",
      "onCommand:gitagotchi.viewStats",
      "onCommand:gitagotchi.openDex",
      "onCommand:gitagotchi.checkCommit",
      "onCommand:gitagotchi.leaderboard",
      "onCommand:gitagotchi.createLeaderboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitagotchi.openPet",
        "title": "Gitagotchi: Open Pet"
      },
      {
        "command": "gitagotchi.renamePet",
        "title": "Gitagotchi: Rename Pet"
      },
      {
        "command": "gitagotchi.resetPet",
        "title": "Gitagotchi: Reset Pet"
      },
      {
        "command": "gitagotchi.feed",
        "title": "Gitagotchi: Feed"
      },
      {
        "command": "gitagotchi.viewStats",
        "title": "Gitagotchi: View Stats"
      },
      {
        "command": "gitagotchi.openDex",
        "title": "Gitagotchi: Open Dex"
      },
      {
        "command": "gitagotchi.checkCommit",
        "title": "Gitagotchi: Check Commit"
      },
      {
        "command": "gitagotchi.leaderboard",
        "title": "Gitagotchi: Leaderboard"
      },
      {
        "command": "gitagotchi.createLeaderboard",
        "title": "Gitagotchi: Create Leaderboard"
      }
    ],
    "configuration": {
      "title": "Gitagotchi",
      "properties": {
        "gitagotchi.leaderboard.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable hourly GitHub Gist leaderboard sync."
        },
        "gitagotchi.leaderboard.gistId": {
          "type": "string",
          "default": "",
          "description": "GitHub Gist ID containing leaderboard.json."
        },
        "gitagotchi.leaderboard.displayName": {
          "type": "string",
          "default": "",
          "description": "Display name used on the leaderboard. Falls back to the GitHub login."
        }
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.cjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "package": "vsce package",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "littlejsengine": "^1.18.1"
  }
}
